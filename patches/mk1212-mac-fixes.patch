new file mode 100755
index 0000000..fc39dbf
--- /dev/null
+++ b/scripts/build-runtime-patch
@@ -0,0 +1,25 @@
+#!/bin/zsh
+set -euo pipefail
+
+repo_root="${0:A:h:h}"
+output="${1:-$repo_root/build/libmk1212-slot-runtime-patch.dylib}"
+source_file="${2:-$repo_root/src/mk1212_slot_runtime_patch.c}"
+signing_identity="${CODESIGN_IDENTITY:--}"
+
+mkdir -p "${output:h}"
+/usr/bin/xcrun clang \
+    -arch arm64 \
+    -dynamiclib \
+    -mmacosx-version-min=12.0 \
+    -Wl,-install_name,@rpath/libmk1212-slot-runtime-patch.dylib \
+    -Wall -Wextra -Werror \
+    "$source_file" \
+    -o "$output"
+
+sign_args=(--force --sign "$signing_identity")
+if [[ "$signing_identity" != "-" ]]; then
+    sign_args+=(--options runtime --timestamp)
+fi
+/usr/bin/codesign "${sign_args[@]}" "$output"
+/usr/bin/codesign --verify --strict "$output"
+print "$output"
