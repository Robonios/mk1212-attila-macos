+def lua_short_string_line_break(text: str) -> int | None:
+    """Return the line of the first unescaped line break inside a quoted string.
+
+    Lua 5.1 rejects a raw line break inside '...' or "..." ("unfinished
+    string"); luaparser accepts it, so this rule is checked separately.
+    Comments and long brackets ([[...]], [==[...]==]) may span lines.
+    """
+    index, length = 0, len(text)
+    while index < length:
+        char = text[index]
+        if text.startswith("--", index):
+            index += 2
+            match = re.match(r"\[(=*)\[", text[index:])
+            if match:
+                close = "]" + match.group(1) + "]"
+                end = text.find(close, index + match.end())
+                index = length if end < 0 else end + len(close)
+            else:
+                end = text.find("\n", index)
+                index = length if end < 0 else end
+            continue
+        if char == "[":
+            match = re.match(r"\[(=*)\[", text[index:])
+            if match:
+                close = "]" + match.group(1) + "]"
+                end = text.find(close, index + match.end())
+                index = length if end < 0 else end + len(close)
+                continue
+        if char in "\"'":
+            start = index
+            index += 1
+            while index < length and text[index] != char:
+                if text[index] == "\\":
+                    index += 2            # an escaped character, including \<newline>
+                    continue
+                if text[index] in "\r\n":
+                    return text.count("\n", 0, start) + 1
+                index += 1
+            index += 1
+            continue
+        index += 1
+    return None
+
