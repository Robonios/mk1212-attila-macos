+        )
+    if "status=armed " in patch_result:
+        raise ToolError(
+            "ATTILA exited, but the patch log shows the deferred (armed) library, not the "
+            f"load-time build; inspect {patch_log}"
+        )
+    if expected_status != "inject-only" and "status=inject-only " in patch_result:
+        raise ToolError(
+            "ATTILA exited, but the patch log shows inject-only from a library that is not "
+            f"the inject-only diagnostic build; inspect {patch_log}"
+        )
+    if f"status={expected_status} kern_return=0" not in patch_result:
+        raise ToolError(
+            f"ATTILA exited, but the ten-slot runtime patch did not report {expected_status}; "
+            f"inspect {patch_log}"
+        )
