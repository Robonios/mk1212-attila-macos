+def lua51_compile_error(data: bytes, chunk_name: str) -> str | None:
+    """Compile (never run) a chunk with a real Lua 5.1, the game's own version.
+
+    Returns None if it compiles, otherwise Lua's error message.
+    """
+    global _LUA51_COMPILE
+    if _LUA51_COMPILE is None:
+        try:
+            from lupa import lua51
+        except ImportError as error:
+            raise ToolError(
+                "Lua 5.1 compile checking needs lupa: /usr/bin/python3 -m pip install --user lupa"
+            ) from error
+        runtime = lua51.LuaRuntime()
+        if runtime.eval("_VERSION") != "Lua 5.1":
+            raise ToolError("lupa.lua51 did not provide a Lua 5.1 runtime; refusing to validate with it")
+        _LUA51_COMPILE = runtime.eval(
+            "function(source, name) local chunk, err = loadstring(source, name) "
+            "if chunk then return true end return err end"
+        )
+    result = _LUA51_COMPILE(data, "=" + chunk_name)
+    return None if result is True else str(result)
+
+
+def validate_lua_syntax(relative_path: str, data: bytes) -> None:
+    """Refuse a repaired Lua file that the game's Lua 5.1 loader would reject."""
+    compile_error = lua51_compile_error(data, relative_path)
+    if compile_error is not None:
+        raise ToolError(f"repaired Lua {relative_path} does not compile under Lua 5.1: {compile_error}; "
+                        "refusing to install it")
+    try:
+        from luaparser import ast as lua_ast
+    except ImportError as error:
+        raise ToolError(
+            "Lua syntax checking needs luaparser: /usr/bin/python3 -m pip install --user luaparser"
+        ) from error
+    text = data.decode("latin-1")
+    broken_line = lua_short_string_line_break(text)
+    if broken_line is not None:
+        raise ToolError(
+            f"repaired Lua {relative_path} has a line break inside a quoted string at line {broken_line}; "
+            "refusing to install it"
+        )
+    try:
+        lua_ast.parse(text)
+    except Exception as error:
+        message = str(error).strip().splitlines()[0] if str(error).strip() else type(error).__name__
+        raise ToolError(f"repaired Lua {relative_path} does not parse: {message}; refusing to install it") from error
+
